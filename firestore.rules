rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // 1. FONCTIONS GÉNÉRALES ET AUTHENTIFICATION
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true
        );
    }

    function primaryAdmin() {
      return admin()
        && request.auth.token.email == 'henochshungu@gmail.com';
    }

    function member(cid) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(cid))
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(cid)
        ).data.members;
    }

    function groupAdmin(cid) {
      return primaryAdmin()
        || (
          member(cid)
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(cid)
          ).data.get('admins', [])
        );
    }

    function groupMentor(cid) {
      return member(cid)
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(cid)
        ).data.get('mentors', []);
    }

    function groupModerator(cid) {
      return groupAdmin(cid) || groupMentor(cid);
    }

    // =====================================================
    // 2. UTILISATEURS
    // =====================================================

    match /users/{uid} {

      // Un compte auto-inscrit commence obligatoirement en Free et non payé.
      // Les champs d'abonnement privilégiés ne peuvent pas être fournis par le client.
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'avatarId',
          'avatarURL',
          'photoURL',
          'traderProfile',
          'plan',
          'role',
          'status',
          'createdAt',
          'subscriptionStatus',
          'subscriptionStartAt',
          'paymentStatus',
          'settings'
        ])
        && request.resource.data.get('uid', '') == uid
        && request.resource.data.get('role', '') == 'trader'
        && request.resource.data.get('status', '') == 'active'
        && request.resource.data.get('plan', '') == 'free'
        && request.resource.data.get('subscriptionStatus', '') == 'active'
        && request.resource.data.get('paymentStatus', '') == 'unpaid';

      allow read: if owner(uid) || admin();

      // Modification du profil par son propriétaire.
      // Les privilèges et le statut ne peuvent pas être modifiés.
      allow update: if owner(uid)
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.get('admin', false) == resource.data.get('admin', false)
        && request.resource.data.get('status', '') == resource.data.get('status', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'avatarURL',
          'avatarConfig',
          'email',
          'settings',
          'pendingPlan',
          'planChangeRequestedAt',
          'updatedAt'
        ]);

      // Seul l'administrateur principal peut modifier les privilèges et abonnements directement.
      // Les opérations de la console passent par le Worker authentifié.
      allow update: if primaryAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'admin',
          'status',
          'plan',
          'paymentDate',
          'subscriptionStartAt',
          'subscriptionExpiresAt',
          'subscriptionStatus',
          'paymentStatus',
          'pendingPlan',
          'planChangeRequestedAt',
          'planChangeConfirmedAt',
          'updatedAt'
        ]);

      allow delete: if admin();
    }

    // =====================================================
    // 3. SESSIONS UTILISATEURS
    // =====================================================

    match /users/{uid}/sessions/{sessionId} {

      allow get, list: if owner(uid);

      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'deviceName',
          'userAgent',
          'createdAt',
          'lastSeenAt',
          'revoked'
        ])
        && request.resource.data.get('revoked', false) == false;

      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastSeenAt',
          'revoked',
          'revokedAt'
        ])
        && request.resource.data.get('revoked', false) is bool
        && (
          request.resource.data.get('revoked', false)
            == resource.data.get('revoked', false)
          || request.resource.data.get('revoked', false) == true
        );

      allow delete: if owner(uid);
    }

    // =====================================================
    // 4. PROFILS PUBLICS
    // =====================================================

    match /publicProfiles/{uid} {

      allow get, list: if signedIn();

      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'username',
          'avatarURL',
          'photoURL',
          'updatedAt'
        ]);

      allow update: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'displayName',
          'username',
          'avatarURL',
          'photoURL',
          'updatedAt'
        ]);

      allow delete: if owner(uid);
    }

    // =====================================================
    // 5. DEMANDES D'AMITIÉ
    // =====================================================

    match /friendRequests/{id} {

      allow get, list: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'senderId',
          'receiverId',
          'status',
          'senderName',
          'receiverName',
          'createdAt',
          'updatedAt'
        ]);

      allow update: if signedIn()
        && resource.data.receiverId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // =====================================================
    // 6. PIPTALK : CONVERSATIONS ET GROUPES
    // =====================================================

    match /conversations/{cid} {

      // Lecture des conversations.
      allow get, list: if signedIn()
        && (
          cid == 'community-hub'
          || request.auth.uid in resource.data.members
        );

      // -------------------------------------------------
      // CRÉATION DES GROUPES
      // -------------------------------------------------

      allow create: if cid == 'community-hub'

        // Création du Community Hub.
        ? primaryAdmin()
          && request.resource.data.title == 'Community Hub'
          && request.resource.data.group == true
          && request.resource.data.systemGroup == true
          && request.resource.data.members is list
          && request.resource.data.members.size() >= 1
          && request.resource.data.members.size() <= 500

        // Création des groupes ordinaires.
        : primaryAdmin()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.group == true
          && request.resource.data.systemGroup == false
          && request.resource.data.members is list
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() >= 1
          && request.resource.data.members.size() <= 500
          && request.resource.data.admins == [request.auth.uid]
          && request.resource.data.mentors == []
          && request.resource.data.closed == false;

      // -------------------------------------------------
      // MODIFICATION DES CONVERSATIONS
      // -------------------------------------------------

      allow update: if cid == 'community-hub'

        // Règles particulières du Community Hub.
        ? signedIn()
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.systemGroup == resource.data.systemGroup
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'lastMessage',
                'updatedAt',
                'memberNames'
              ])
            || (
              primaryAdmin()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'title',
                  'description',
                  'avatarURL',
                  'updatedAt'
                ])
            )
          )

        // Règles des groupes ordinaires.
        : member(cid)
          && request.resource.data.createdBy == resource.data.createdBy
          && (

            // Mise à jour des informations de conversation.
            (
              request.resource.data.members == resource.data.members
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'lastMessage',
                  'updatedAt',
                  'memberNames',
                  'title',
                  'description',
                  'avatarURL'
                ])
            )

            // Gestion administrative du groupe :
            // paramètres, membres, rôles et invitations.
            || (
              groupAdmin(cid)

              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'title',
                  'description',
                  'avatarURL',
                  'updatedAt',
                  'closed',
                  'admins',
                  'mentors',
                  'members',
                  'memberNames',
                  'inviteCode',
                  'inviteEnabled'
                ])

              && request.resource.data.members is list
              && request.auth.uid in request.resource.data.members
              && resource.data.createdBy in request.resource.data.members

              && request.resource.data.admins is list
              && request.resource.data.admins.hasAll([
                resource.data.createdBy
              ])
              && request.resource.data.admins.hasOnly(
                request.resource.data.members
              )

              && request.resource.data.mentors is list
              && request.resource.data.mentors.hasOnly(
                request.resource.data.members
              )

              && request.resource.data.get('mutedMembers', []).hasOnly(
                request.resource.data.members
              )

              && request.resource.data.get('closed', false) is bool
              && request.resource.data.systemGroup == false
              && request.resource.data.get('avatarURL', '') is string
              && request.resource.data.get('title', '') is string
              && request.resource.data.get('description', '') is string

              && (
                !('inviteEnabled' in request.resource.data)
                || request.resource.data.inviteEnabled is bool
              )

              && (
                !('inviteCode' in request.resource.data)
                || request.resource.data.inviteCode is string
              )
            )

            // Mise en sourdine et réactivation.
            // Autorisé aux administrateurs et aux mentors.
            || (
              groupModerator(cid)

              && request.resource.data.members == resource.data.members

              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'mutedMembers',
                  'updatedAt'
                ])

              && request.resource.data.get('mutedMembers', []) is list

              && request.resource.data.get('mutedMembers', []).size()
                <= request.resource.data.members.size()

              && request.resource.data.get('mutedMembers', []).hasOnly(
                request.resource.data.members
              )
            )
          );

      // Suppression d'un groupe.
      // Le Community Hub ne peut pas être supprimé.
      allow delete: if groupAdmin(cid)
        && resource.data.get('systemGroup', false) == false;

      // =================================================
      // 7. ÉTATS DE LECTURE DES CONVERSATIONS
      // =================================================

      match /readStates/{uid} {

        allow get: if signedIn()
          && request.auth.uid == uid
          && (
            cid == 'community-hub'
            || member(cid)
          );

        allow list: if false;

        allow create, update: if signedIn()
          && request.auth.uid == uid
          && (
            cid == 'community-hub'
            || member(cid)
          )
          && request.resource.data.keys().hasOnly([
            'userId',
            'lastReadAt',
            'updatedAt'
          ])
          && request.resource.data.userId == uid
          && request.resource.data.lastReadAt is timestamp
          && request.resource.data.updatedAt is timestamp;

        allow delete: if false;
      }

      // =================================================
      // 8. PIPTALK : MESSAGES
      // =================================================

      match /messages/{messageId} {

        // Lecture des messages.
        // Un membre muet conserve son accès à la lecture.
        function canReadChat() {
          return signedIn()
            && (
              cid == 'community-hub'
              ? member(cid)
              : member(cid)
                && (
                  !get(
                    /databases/$(database)/documents/conversations/$(cid)
                  ).data.get('closed', false)
                  || groupAdmin(cid)
                  || groupMentor(cid)
                )
            );
        }

        // Publication des messages.
        // Un membre muet ne peut plus publier.
        // Les administrateurs et mentors conservent ce droit.
        function canSendChat() {
          return canReadChat()
            && (
              cid == 'community-hub'
              || !(
                request.auth.uid in get(
                  /databases/$(database)/documents/conversations/$(cid)
                ).data.get('mutedMembers', [])
              )
              || groupAdmin(cid)
              || groupMentor(cid)
            );
        }

        // Lire les messages.
        allow get, list: if canReadChat();

        // Envoyer des messages texte, images ou vocaux.
        allow create: if canSendChat()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 10000;

        // Modifier les messages.
        allow update: if (

          // Épingler ou désépingler.
          canReadChat()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pinned'])
          && request.resource.data.pinned is bool

        ) || (

          // Ajouter ou modifier une réaction.
          canReadChat()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(
            resource.data.get('reactions', {})
          ).affectedKeys().hasOnly([
            request.auth.uid
          ])
          && (
            !(
              request.auth.uid in request.resource.data.reactions
            )
            || request.resource.data.reactions[request.auth.uid]
              in ['❤️', '👍', '😂', '🔥', '😮', '🙏']
          )

        ) || (

          // Modifier son propre message.
          // Un membre muet ne peut plus modifier ses messages.
          canSendChat()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'text',
              'edited',
              'editedAt',
              'pinned'
            ])
          && (
            !('text' in request.resource.data)
            || (
              request.resource.data.text is string
              && request.resource.data.text.size() <= 10000
            )
          )

        ) || (

          // Modification administrative des informations d'expéditeur
          // dans Community Hub.
          cid == 'community-hub'
          && admin()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'senderName',
              'senderAvatarURL'
            ])
          && (
            !('senderName' in request.resource.data)
            || request.resource.data.senderName is string
          )
          && (
            !('senderAvatarURL' in request.resource.data)
            || request.resource.data.senderAvatarURL is string
          )
        );

        // Suppression d'un message.
        allow delete: if canReadChat()
          && (
            resource.data.senderId == request.auth.uid
            || groupAdmin(cid)
          );
      }
    }

    // =====================================================
    // 9. COMPTES DE TRADING
    // =====================================================

    match /accounts/{id} {

      allow read: if admin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // =====================================================
    // 10. MOUVEMENTS DES COMPTES
    // =====================================================

    match /accounts/{accountId}/movements/{movementId} {

      function ownsAccount() {
        return signedIn()
          && exists(
            /databases/$(database)/documents/accounts/$(accountId)
          )
          && get(
            /databases/$(database)/documents/accounts/$(accountId)
          ).data.userId == request.auth.uid;
      }

      allow get, list: if ownsAccount();

      allow create: if ownsAccount()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.accountId == accountId
        && request.resource.data.type in [
          'deposit',
          'withdrawal',
          'fee',
          'payout',
          'adjustment'
        ]
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.signedAmount is number
        && request.resource.data.note is string
        && request.resource.data.createdAt is string;

      allow update: if false;

      allow delete: if ownsAccount();
    }

    // =====================================================
    // 11. JOURNAL DE TRADING
    // =====================================================

    match /trades/{id} {

      allow read: if admin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // =====================================================
    // 12. MESSAGES DE CONTACT
    // =====================================================

    match /contactMessages/{id} {

      allow create: if request.resource.data.get('status', '') == 'new'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.email.size() <= 320
        && request.resource.data.subject.size() <= 300
        && request.resource.data.message.size() <= 10000;

      allow read, update, delete: if admin();
    }

    // =====================================================
    // 13. ANALYSES QUOTIDIENNES
    // =====================================================

    match /dailyAnalyses/{id} {

      allow read: if signedIn()
        && (
          admin()
          || resource.data.status in ['published', 'closed']
        );

      allow create: if admin()
        && request.resource.data.asset == 'XAUUSD'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in [
          'draft',
          'published',
          'closed'
        ];

      allow update: if admin()
        && request.resource.data.asset == 'XAUUSD'
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'asset',
          'tradingViewUrl',
          'afterAnalysisUrl',
          'outcomeStatus',
          'exitPrice',
          'closureStatus',
          'direction',
          'entryPrice',
          'stopLoss',
          'takeProfit',
          'setup',
          'setupGrade',
          'dailyBias',
          'htfBias',
          'entryBias',
          'htf',
          'ltf',
          'marketPhase',
          'session',
          'liquidityTarget',
          'poi',
          'confirmation',
          'invalidation',
          'notes',
          'status',
          'updatedAt',
          'updatedBy'
        ]);

      allow delete: if admin();
    }

    // =====================================================
    // 14. REPLAY SESSIONS
    // =====================================================

    match /replaySessions/{uid}/sessions/{sessionId} {

      function owns() {
        return owner(uid);
      }

      function validSession() {
        return request.resource.data.keys().hasOnly([
          'name',
          'symbol',
          'timeframe',
          'datasetName',
          'datasetStart',
          'datasetEnd',
          'candleCount',
          'currentIndex',
          'drawings',
          'positions',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.symbol == 'XAUUSD'
        && request.resource.data.timeframe in [
          'M1',
          'M5',
          'M15',
          'M30',
          'H1',
          'H4',
          'D1'
        ]
        && request.resource.data.drawings is list
        && request.resource.data.drawings.size() <= 100
        && request.resource.data.positions is list
        && request.resource.data.positions.size() <= 500
        && request.resource.data.currentIndex is int
        && request.resource.data.currentIndex >= 0
        && request.resource.data.candleCount is int
        && request.resource.data.candleCount >= 0
        && request.resource.data.currentIndex
          <= request.resource.data.candleCount;
      }

      allow get, list: if owns();

      allow create: if owns()
        && validSession()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if owns()
        && validSession()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if owns();
    }

    // =====================================================
    // 15. PROGRESSION DES DONNÉES ÉCONOMIQUES
    // =====================================================

    match /economicDataProgress/{id} {
      allow read, write: if admin();
    }

    // =====================================================
    // 16. JOURNAUX ADMINISTRATIFS
    // =====================================================

    match /adminLogs/{id} {

      allow read, create: if admin();

      allow update, delete: if false;
    }

    // =====================================================
    // 17. PAIEMENTS
    // =====================================================

    match /payments/{id} {

      allow read: if admin();

      // Les écritures de paiement doivent passer par le Worker
      // et les opérations serveur autorisées.
      allow write: if false;
    }

    // =====================================================
    // 18. REFUS PAR DÉFAUT
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}