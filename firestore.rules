rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true
        );
    }
    function member(cid) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(cid))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.members;
    }

    match /users/{uid} {
      allow create: if owner(uid)
        && request.resource.data.get('role', '') == 'trader'
        && request.resource.data.get('status', '') == 'active'
        && request.resource.data.get('admin', false) == false;
      allow read: if owner(uid) || admin();
      allow update: if owner(uid)
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.get('admin', false) == resource.data.get('admin', false)
        && request.resource.data.get('status', '') == resource.data.get('status', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'avatarURL', 'avatarConfig', 'email',
          'settings', 'pendingPlan', 'planChangeRequestedAt', 'updatedAt'
        ]);
      allow delete: if admin();
    }

    // Session rules are defined once, with no permissive overlapping rule.
    match /users/{uid}/sessions/{sessionId} {
      allow get, list: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['deviceName', 'userAgent', 'createdAt', 'lastSeenAt', 'revoked'])
        && request.resource.data.get('revoked', false) == false;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'revoked', 'revokedAt'])
        && request.resource.data.get('revoked', false) is bool
        && (request.resource.data.get('revoked', false) == resource.data.get('revoked', false)
          || request.resource.data.get('revoked', false) == true);
      allow delete: if owner(uid);
    }

    match /publicProfiles/{uid} {
      allow get, list: if signedIn();
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'username', 'avatarURL', 'photoURL', 'updatedAt']);
      allow update: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'displayName', 'username', 'avatarURL', 'photoURL', 'updatedAt']);
      allow delete: if owner(uid);
    }

    match /friendRequests/{id} {
      allow get, list: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['senderId', 'receiverId', 'status', 'senderName', 'receiverName', 'createdAt', 'updatedAt']);
      allow update: if signedIn()
        && resource.data.receiverId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /conversations/{cid} {
      allow get, list: if signedIn() && (cid == 'community-hub' || request.auth.uid in resource.data.members);
      allow create: if cid == 'community-hub'
        ? admin()
          && request.resource.data.title == 'Community Hub'
          && request.resource.data.group == true
          && request.resource.data.systemGroup == true
          && request.resource.data.members is list
          && request.resource.data.members.size() >= 1
          && request.resource.data.members.size() <= 500
        : signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.members is list
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() >= 2
          && request.resource.data.members.size() <= 50;
      allow update: if cid == 'community-hub'
        ? signedIn()
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.systemGroup == resource.data.systemGroup
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'memberNames'])
            || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'avatarURL', 'updatedAt']))
          )
        : member(cid)
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'title', 'memberNames']);
      allow delete: if false;

      match /readStates/{uid} {
        allow get: if signedIn() && request.auth.uid == uid
          && (cid == 'community-hub' || member(cid));
        allow list: if false;
        allow create, update: if signedIn() && request.auth.uid == uid
          && (cid == 'community-hub' || member(cid))
          && request.resource.data.keys().hasOnly(['userId', 'lastReadAt', 'updatedAt'])
          && request.resource.data.userId == uid
          && request.resource.data.lastReadAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }

      match /messages/{messageId} {
        function canChat() { return signedIn() && (cid == 'community-hub' || member(cid)); }
        allow get, list: if canChat();
        allow create: if canChat()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 10000;
        allow update: if (
          canChat()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
          && request.resource.data.pinned is bool
        ) || (
          canChat()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions) || request.resource.data.reactions[request.auth.uid] in ['❤️', '👍', '😂', '🔥', '😮', '🙏'])
        ) || (
          canChat()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt', 'pinned'])
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 10000))
        ) || (
          cid == 'community-hub' && admin()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senderName', 'senderAvatarURL'])
          && (!('senderName' in request.resource.data) || request.resource.data.senderName is string)
          && (!('senderAvatarURL' in request.resource.data) || request.resource.data.senderAvatarURL is string)
        );
        allow delete: if canChat() && resource.data.senderId == request.auth.uid;
      }
    }

    match /accounts/{id} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /trades/{id} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /contactMessages/{id} {
      allow create: if request.resource.data.get('status', '') == 'new'
        && request.resource.data.name is string && request.resource.data.email is string
        && request.resource.data.subject is string && request.resource.data.message is string
        && request.resource.data.name.size() <= 200 && request.resource.data.email.size() <= 320
        && request.resource.data.subject.size() <= 300 && request.resource.data.message.size() <= 10000;
      allow read, update, delete: if admin();
    }

    match /dailyAnalyses/{id} {
      allow read: if signedIn() && (admin() || resource.data.status in ['published', 'closed']);
      allow create: if admin() && request.resource.data.asset == 'XAUUSD'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ['draft', 'published', 'closed'];
      allow update: if admin()
        && request.resource.data.asset == 'XAUUSD'
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'asset', 'tradingViewUrl', 'afterAnalysisUrl', 'outcomeStatus', 'exitPrice',
          'closureStatus', 'direction', 'entryPrice', 'stopLoss', 'takeProfit',
          'setup', 'setupGrade', 'dailyBias', 'htfBias', 'entryBias', 'htf', 'ltf',
          'marketPhase', 'session', 'liquidityTarget', 'poi', 'confirmation',
          'invalidation', 'notes', 'status', 'updatedAt', 'updatedBy'
        ]);
      allow delete: if admin();
    }

    match /replaySessions/{uid}/sessions/{sessionId} {
      function owns() { return owner(uid); }
      function validSession() {
        return request.resource.data.keys().hasOnly([
          'name', 'symbol', 'timeframe', 'datasetName', 'datasetStart', 'datasetEnd',
          'candleCount', 'currentIndex', 'drawings', 'positions', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.symbol == 'XAUUSD'
        && request.resource.data.timeframe in ['M1', 'M5', 'M15', 'M30', 'H1', 'H4', 'D1']
        && request.resource.data.drawings is list && request.resource.data.drawings.size() <= 100
        && request.resource.data.positions is list && request.resource.data.positions.size() <= 500
        && request.resource.data.currentIndex is int && request.resource.data.currentIndex >= 0
        && request.resource.data.candleCount is int && request.resource.data.candleCount >= 0
        && request.resource.data.currentIndex <= request.resource.data.candleCount;
      }
      allow get, list: if owns();
      allow create: if owns() && validSession()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owns() && validSession()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if owns();
    }

    match /economicDataProgress/{id} { allow read, write: if admin(); }
    match /adminLogs/{id} {
      allow read, create: if admin();
      allow update, delete: if false;
    }
    match /payments/{id} {
      allow read: if admin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}