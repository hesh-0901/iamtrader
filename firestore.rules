rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // A new user may create only a normal trader profile.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'trader'
        && request.resource.data.status == 'active';

      // Users can read their own profile.
      allow read: if isOwner(userId);

      // Users may update personal/profile settings only.
      // Plan, role, status and subscription fields remain admin-controlled.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'email', 'settings', 'pendingPlan', 'planChangeRequestedAt', 'updatedAt']);

      // Full user administration requires the Firestore admin role.
      allow read, write: if isAdmin();
    }

    match /accounts/{accountId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /contactMessages/{messageId} {
      // Contact forms may create a new ticket; only administrators can read or manage tickets.
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      // Payment transactions are written by the secure Worker and are never
      // directly writable from the browser. Admins can read the ledger.
      allow read: if isAdmin();
      allow write: if false;
    }


    match /trades/{tradeId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}