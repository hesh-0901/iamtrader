rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Le rôle de sécurité réel vient du custom claim Firebase.
    // Le champ role du profil sert à distinguer l'utilisateur dans l'application,
    // mais ne peut jamais à lui seul donner les privilèges superadmin.
    function isSuperAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isAdmin() {
      return isSuperAdmin();
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.role == 'retail'
        && request.resource.data.plan == 'free'
        && request.resource.data.status == 'active';
      allow read: if isOwner(uid) || isAdmin();

      // Users may update their profile, but never self-promote their access level.
      allow update: if isAdmin()
        || (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.plan == resource.data.plan
          && request.resource.data.status == resource.data.status
          && request.resource.data.requestedPlan == resource.data.requestedPlan
          && request.resource.data.communityStatus == resource.data.communityStatus);

      allow delete: if isOwner(uid) || isAdmin();
    }

    match /accounts/{accountId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if isAdmin();
    }

    match /trades/{tradeId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if isAdmin();
    }

    match /communityRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && resource.data.uid == request.auth.uid || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
