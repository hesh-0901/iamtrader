rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // A new user may create only a normal trader profile.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'trader'
        && request.resource.data.status == 'active';

      // Users can read their own profile.
      allow read: if isOwner(userId);

      // Users may update personal/profile settings only.
      // Plan, role, status and subscription fields remain admin-controlled.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'avatarURL', 'avatarConfig', 'email', 'settings', 'pendingPlan', 'planChangeRequestedAt', 'updatedAt']);

      // Full user administration requires the Firestore admin role.
      allow read, write: if isAdmin();
    }

    // PipTalk conversations. Community Hub is a fixed system group for all signed-in users.
    match /conversations/{conversationId} {
      function isConversationMember() {
        return isAuthenticated() && request.auth.uid in resource.data.members;
      }
      allow read: if conversationId == 'community-hub' ? isAuthenticated() : isConversationMember();
      allow create: if conversationId == 'community-hub'
        ? isAdmin()
          && request.resource.data.title == 'Community Hub'
          && request.resource.data.group == true
          && request.resource.data.systemGroup == true
          && request.resource.data.createdBy == request.auth.uid
        : isAuthenticated()
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members is list
          && request.resource.data.members.size() >= 2
          && request.resource.data.members.size() <= 50;
      allow update: if conversationId == 'community-hub'
        ? isAuthenticated()
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.systemGroup == resource.data.systemGroup
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage', 'updatedAt', 'memberNames'])
            || (
              isAdmin()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['title', 'description', 'avatarURL', 'updatedAt'])
            )
          )
        : isConversationMember()
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'updatedAt', 'title', 'memberNames']);
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId));
        }
        function isMember() {
          return isAuthenticated() && (
            conversationId == 'community-hub'
            || request.auth.uid in parentConversation().data.members
          );
        }
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 10000;
        // The author may edit message content; admins may only backfill
        // display name/avatar metadata on legacy messages.
        allow update: if (
          isMember()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'edited', 'editedAt', 'pinned'])
          && (!('text' in request.resource.data) || request.resource.data.text is string)
        ) || (
          conversationId == 'community-hub'
          && isAdmin()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['senderName', 'senderAvatarURL'])
          && (!('senderName' in request.resource.data) || request.resource.data.senderName is string)
          && (!('senderAvatarURL' in request.resource.data) || request.resource.data.senderAvatarURL is string)
        );
        allow delete: if isMember() && resource.data.senderId == request.auth.uid;
      }
    }

    match /accounts/{accountId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /contactMessages/{messageId} {
      // Contact forms may create a new ticket; only administrators can read or manage tickets.
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      // Payment transactions are written by the secure Worker and are never
      // directly writable from the browser. Admins can read the ledger.
      allow read: if isAdmin();
      allow write: if false;
    }


    match /trades/{tradeId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}