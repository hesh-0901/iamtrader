rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
        );
    }

    match /users/{userId} {
      // A new user may create only a normal trader profile.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'trader'
        && request.resource.data.status == 'active';

      // Users can read their own profile.
      allow read: if isOwner(userId);

      // Users may update personal/profile settings only.
      // Plan, role, status and subscription fields remain admin-controlled.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'avatarURL', 'avatarConfig', 'email', 'settings', 'pendingPlan', 'planChangeRequestedAt', 'updatedAt']);

      // Full user administration requires the Firestore admin role.
      allow read, write: if isAdmin();
    }

    // Device sessions are owned by each user and can be revoked from account security settings.
    match /users/{userId}/sessions/{sessionId} {
      allow read, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['deviceName', 'userAgent', 'createdAt', 'lastSeenAt', 'revoked'])
        && request.resource.data.revoked == false;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'revoked', 'revokedAt'])
        && (request.resource.data.revoked == resource.data.revoked || request.resource.data.revoked == true);
      allow delete: if isOwner(userId);
    }

    // Public trader directory: expose only profile-card fields, never private user documents.
    // Each authenticated user can publish/update only their own public profile.
    match /publicProfiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(profileId)
        && request.resource.data.uid == profileId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'avatarURL', 'photoURL', 'updatedAt'
        ]);
      // Existing public cards may contain legacy fields; allow the owner to
      // refresh only the public-card fields without letting private fields be added.
      allow update: if isOwner(profileId)
        && request.resource.data.uid == profileId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'displayName', 'username', 'avatarURL', 'photoURL', 'updatedAt'
        ]);
      allow delete: if isOwner(profileId);
    }

    // Friend requests are visible only to their sender and receiver.
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated()
        && (resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'senderId', 'receiverId', 'status', 'senderName', 'receiverName',
          'createdAt', 'updatedAt'
        ]);
      allow update: if isAuthenticated()
        && resource.data.receiverId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // PipTalk conversations. Community Hub is a fixed system group for all signed-in users.
    match /conversations/{conversationId} {
      function isConversationMember() {
        return isAuthenticated() && request.auth.uid in resource.data.members;
      }
      allow read: if conversationId == 'community-hub' ? isAuthenticated() : isConversationMember();
      allow create: if conversationId == 'community-hub'
        ? isAuthenticated()
          && request.resource.data.title == 'Community Hub'
          && request.resource.data.group == true
          && request.resource.data.systemGroup == true
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.members is list
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() >= 1
          && request.resource.data.members.size() <= 500
        : isAuthenticated()
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members is list
          && request.resource.data.members.size() >= 2
          && request.resource.data.members.size() <= 50;
      allow update: if conversationId == 'community-hub'
        ? isAuthenticated()
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.systemGroup == resource.data.systemGroup
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage', 'updatedAt', 'memberNames'])
            || (
              isAdmin()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['title', 'description', 'avatarURL', 'updatedAt'])
            )
          )
        : isConversationMember()
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'updatedAt', 'title', 'memberNames']);
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId));
        }
        function isMember() {
          return isAuthenticated() && (
            conversationId == 'community-hub'
            || request.auth.uid in parentConversation().data.members
          );
        }
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 10000;
        // The author may edit message content; admins may only backfill
        // display name/avatar metadata on legacy messages.
        allow update: if (
          // Any conversation member may pin or unpin a message, like a group chat.
          isMember()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
          && request.resource.data.pinned is bool
        ) || (
          // Authors can edit their own message content and pin state.
          isMember()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'edited', 'editedAt', 'pinned'])
          && (!('text' in request.resource.data) || request.resource.data.text is string)
        ) || (
          conversationId == 'community-hub'
          && isAdmin()
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['senderName', 'senderAvatarURL'])
          && (!('senderName' in request.resource.data) || request.resource.data.senderName is string)
          && (!('senderAvatarURL' in request.resource.data) || request.resource.data.senderAvatarURL is string)
        );
        allow delete: if isMember() && resource.data.senderId == request.auth.uid;
      }
    }

    match /accounts/{accountId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /contactMessages/{messageId} {
      // Contact forms may create a new ticket; only administrators can read or manage tickets.
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }

    // Analyses quotidiennes XAUUSD : lecture aux utilisateurs connectés, gestion admin uniquement.
    match /dailyAnalyses/{analysisId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.status in ['published', 'closed']);
      allow create: if isAdmin()
        && request.resource.data.asset == 'XAUUSD'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ['draft', 'published', 'closed'];
      allow update: if isAdmin()
        && request.resource.data.asset == 'XAUUSD'
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asset', 'tradingViewUrl', 'afterAnalysisUrl', 'outcomeStatus', 'exitPrice', 'closureStatus', 'direction', 'entryPrice', 'stopLoss', 'takeProfit', 'setup', 'setupGrade', 'dailyBias', 'htfBias', 'entryBias', 'htf', 'ltf', 'marketPhase', 'session', 'liquidityTarget', 'poi', 'confirmation', 'invalidation', 'notes', 'status', 'updatedAt', 'updatedBy']);
      allow delete: if isAdmin();
    }

    // Progression du pipeline économique : administration uniquement.
    match /economicDataProgress/{progressId} {
      allow read, write: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      // Payment transactions are written by the secure Worker and are never
      // directly writable from the browser. Admins can read the ledger.
      allow read: if isAdmin();
      allow write: if false;
    }


    match /trades/{tradeId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}