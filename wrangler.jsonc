{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iamtrader",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "PAYMENT_SIMULATION_ENABLED": "true",
    "RESEND_FROM_EMAIL": "hello@iamtrader.trade",
    "RESEND_REPLY_TO": "hello@iamtrader.trade",
    "CINETPAY_COUNTRY": "CD",
    "CINETPAY_PLUS_AMOUNT_CDF": "23335",
    "CINETPAY_COMMUNITY_AMOUNT_CDF": "210196"
  },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": {
    "enabled": true
  }
}
