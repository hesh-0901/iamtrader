rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userManager() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
    match /testimonials/{uid}/{testimonialId}/{fileName} {
      function published() {
        return firestore.exists(/databases/(default)/documents/testimonials/$(testimonialId))
          && firestore.get(/databases/(default)/documents/testimonials/$(testimonialId)).data.get('status', '') == 'published';
      }
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow get: if published() || userManager();
      allow update, delete: if userManager();
    }
  }
}